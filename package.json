{
  "name": "browser-control-monorepo",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/protocol --filter ./packages/extension --filter ./packages/cli build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "e2e": "node tests/e2e/run.mjs",
    "clean": "rm -rf packages/*/dist"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
